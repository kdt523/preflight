# GitHub fine-grained token: public repositories, read-only. Used only for backfill.
GITHUB_TOKEN=
# GitHub App webhook secret (set when you register the App, see docs/github-app.md)
GITHUB_WEBHOOK_SECRET=change-me
# Salt for hashing author identities. Any long random string; never commit the real one.
PREFLIGHT_HASH_SALT=change-me-to-a-long-random-string

DATABASE_URL=postgresql+psycopg://preflight:preflight@localhost:5433/preflight
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=preflight-raw
AWS_ACCESS_KEY_ID=preflight
AWS_SECRET_ACCESS_KEY=preflight-secret
AWS_REGION=ap-south-1

# GitHub App (week 4+). See docs/github-app.md
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=secrets/preflight.private-key.pem
