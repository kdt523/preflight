          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2a78d6",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.1
              },
              {
                "color": "#d03b3b",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
