        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Top drifting features",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 106,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
